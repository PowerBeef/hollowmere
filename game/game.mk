# Hollowmere: what the engine's Makefile needs to know about this game.
TARGET     := hollowmere
# cartridge header: title (up to 12 ASCII characters), four-letter game code,
# two-character maker code (00: homebrew)
GAME_TITLE := HOLLOWMERE
GAME_CODE  := HLWE
MAKER_CODE := 00
